---
import { SEO } from "astro-seo";
import { Picture } from "astro:assets";
import "../styles/global.css";

import { Image } from "astro:assets";
import { SimpleAnalytics } from "astro-simpleanalytics-plugin";
import Carousel from "@/components/Carousel.astro";

const priceList = Object.values(
    import.meta.glob("../assets/price-list/*.png", {
        eager: true,
    })
);
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />

        <SEO
            title="Listă de prețuri"
            description="Vezi tarifele pentru cosmetica facială, epilări, extensii de gene și sprâncene"
            extend={{
                link: [{ rel: "icon", href: "/home/favicon.jpg" }],
            }}
            noindex={false}
            nofollow={false}
        />
        <link
            href="https://cdn.jsdelivr.net/npm/flowbite@4.0.1/dist/flowbite.min.css"
            rel="stylesheet"
        />
    </head>
    <body class="bg-neutral-800 text-white">
        <main class="">
            <Carousel images={priceList} />
        </main>
        <SimpleAnalytics />
    </body>
</html>
